# Token del bot Discord (obbligatorio)
DISCORD_TOKEN=il_tuo_token_qui

# Client ID dell'applicazione (obbligatorio per deploy comandi)
CLIENT_ID=il_tuo_client_id

# Opzionale: Guild ID per testare i comandi solo su un server (più veloce)
# GUILD_ID=id_del_server_di_test

# Opzionali: configurazione AI (comandi /chiedi e /riassumi).
# Default: endpoint gratuito Pollinations (nessuna chiave richiesta).
# AI_API_URL=https://text.pollinations.ai
# AI_API_KEY=
# AI_MODEL=
