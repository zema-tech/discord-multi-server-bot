# Token del bot Discord (obbligatorio)
DISCORD_TOKEN=il_tuo_token_qui

# Client ID dell'applicazione (obbligatorio per deploy comandi)
CLIENT_ID=il_tuo_client_id

# Opzionale: Guild ID per testare i comandi solo su un server (più veloce)
# GUILD_ID=id_del_server_di_test

# Opzionali: configurazione AI (comandi /chiedi, /riassumi, /codice, /analizza...).
# Basta UNA chiave: il bot sceglie il provider da solo (auto).
# AI_PROVIDER=auto
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...
# GROQ_API_KEY=gsk_...
# OPENROUTER_API_KEY=sk-or-...
# AI_MODEL= (opzionale: modello custom, default sensato per provider)
# AI_API_URL=https://text.pollinations.ai (default gratis, nessuna chiave richiesta)
# AI_API_KEY=

# Limite giornaliero chiamate AI su chiave condivisa (default 500, 0 = illimitato).
# AI_DAILY_LIMIT=500

# Storage: 'json' (default, file src/database/*.json) o 'sqlite'
# (tabella kv via node:sqlite, Node 22+, zero nuove dipendenze).
# DB_BACKEND=json
# DB_SQLITE_PATH=./data/bot.db

# Logging strutturato (JSON-lines su console + logs/YYYY-MM-DD.log).
# Livelli: debug, info (default), warn, error.
# LOG_LEVEL=info
# LOG_DIR=logs

# Self-improvement notturno: il bot rilegge il suo codice ogni sera e propone/applica 1 patch.
# Mai commit automatici: revisiona con git diff. OFF di default.
# SELF_IMPROVE=1
# SELF_IMPROVE_TIME=22:00
# SELF_IMPROVE_DRY_RUN=1
# SELF_IMPROVE_GUILD_ID=id_server_dove_inviare_il_report

# Dashboard web (PROCESSO SEPARATO dal bot: npm run dashboard).
# Condivide .env e store DB col bot (stessa dir per json, stesso file sqlite).
# Il bot scrive il roster server (presence); la dashboard legge dettagli live via REST.
# Prerequisiti: app Discord con redirect OAuth2 a <BASE_URL>/callback (scope identify+guilds).
# DASHBOARD_PORT=3000
# SESSION_SECRET=genera_una_stringa_lunga_casuale_da_almeno_32_caratteri
# CLIENT_SECRET=il_client_secret_della_tua_app_discord
# BASE_URL=http://localhost:3000
