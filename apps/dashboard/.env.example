# --- Discord OAuth (https://discord.com/developers/applications → OAuth2) ---
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Redirect da registrare sul portale: http://localhost:3000/api/auth/callback/discord

# --- Auth.js ---
NEXTAUTH_SECRET=                    # openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000

# --- Bot (letture live: canali, ruoli, member count) ---
BOT_TOKEN=

# --- Storage ---
# Fase 1: file (stessi JSON del bot, zero migrazione)
STORE_DIR=../../src/database
DB_ADAPTER=file
# Fase 2: Postgres (sblocca deploy Vercel)
# DATABASE_URL=postgresql://user:pass@localhost:5432/bot
# DB_ADAPTER=postgres

# --- Link invito bot (pulsante landing) ---
NEXT_PUBLIC_BOT_INVITE_URL=https://discord.com/oauth2/authorize?client_id=TUO_CLIENT_ID&scope=bot%20applications.commands&permissions=8
