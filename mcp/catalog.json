{
  "$comment": "Catalogo curato stile hermes-agent optional-mcps/: per ogni voce, comando di installazione manuale. Nessuna auto-installazione: leggi sempre il repo upstream prima di eseguire.",
  "catalog": [
    {
      "name": "filesystem",
      "description": "File locali in una dir whitelista (lettura/scrittura limitata).",
      "transport": "stdio",
      "install": "npx -y @modelcontextprotocol/server-filesystem /home/user/projects",
      "needs": [],
      "config": {
        "command": "npx",
        "args": ["-y", "@modelcontextprotocol/server-filesystem", "/home/user/projects"]
      }
    },
    {
      "name": "github",
      "description": "Issue, PR, code search via gh token.",
      "transport": "stdio",
      "install": "npx -y @modelcontextprotocol/server-github",
      "needs": ["GITHUB_PERSONAL_ACCESS_TOKEN"],
      "config": {
        "command": "npx",
        "args": ["-y", "@modelcontextprotocol/server-github"],
        "env": { "GITHUB_PERSONAL_ACCESS_TOKEN": "***" },
        "tools": { "include": ["list_issues", "create_issue", "search_code"] }
      }
    },
    {
      "name": "fetch",
      "description": "GET web sicuri per la AI.",
      "transport": "stdio",
      "install": "npx -y @modelcontextprotocol/server-fetch",
      "needs": [],
      "config": { "command": "npx", "args": ["-y", "@modelcontextprotocol/server-fetch"] }
    },
    {
      "name": "sqlite",
      "description": "Query sul DB locale (consigliato read-only).",
      "transport": "stdio",
      "install": "npx -y @modelcontextprotocol/server-sqlite --db-path ./data/bot.db",
      "needs": [],
      "config": {
        "command": "npx",
        "args": ["-y", "@modelcontextprotocol/server-sqlite", "--db-path", "./data/bot.db"],
        "tools": { "exclude": ["drop_*", "delete_*"] }
      }
    },
    {
      "name": "memory",
      "description": "Memoria persistente a grafo per la AI (entità, relazioni, osservazioni).",
      "transport": "stdio",
      "install": "npx -y @modelcontextprotocol/server-memory",
      "needs": [],
      "config": { "command": "npx", "args": ["-y", "@modelcontextprotocol/server-memory"] }
    },
    {
      "name": "sequential-thinking",
      "description": "Ragionamento passo-passo per problemi complessi (debug, decisioni).",
      "transport": "stdio",
      "install": "npx -y @modelcontextprotocol/server-sequential-thinking",
      "needs": [],
      "config": { "command": "npx", "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"] }
    },
    {
      "name": "brave-search",
      "description": "Ricerca web + news via Brave (serve chiave gratis).",
      "transport": "stdio",
      "install": "npx -y @modelcontextprotocol/server-brave-search",
      "needs": ["BRAVE_API_KEY"],
      "config": {
        "command": "npx",
        "args": ["-y", "@modelcontextprotocol/server-brave-search"],
        "env": { "BRAVE_API_KEY": "***" }
      }
    },
    {
      "name": "postgres",
      "description": "Query SQL in sola lettura su Postgres (whitelista gli schemi).",
      "transport": "stdio",
      "install": "npx -y @modelcontextprotocol/server-postgres <connection-string>",
      "needs": ["connection string"],
      "config": {
        "command": "npx",
        "args": ["-y", "@modelcontextprotocol/server-postgres", "postgresql://user:***@localhost:5432/db"]
      }
    },
    {
      "name": "gitlab",
      "description": "Issue, MR e repo GitLab via token.",
      "transport": "stdio",
      "install": "npx -y @modelcontextprotocol/server-gitlab",
      "needs": ["GITLAB_PERSONAL_ACCESS_TOKEN", "GITLAB_API_URL (se self-hosted)"],
      "config": {
        "command": "npx",
        "args": ["-y", "@modelcontextprotocol/server-gitlab"],
        "env": { "GITLAB_PERSONAL_ACCESS_TOKEN": "***" },
        "tools": { "include": ["list_issues", "create_issue", "search_*"] }
      }
    },
    {
      "name": "puppeteer",
      "description": "Browser headless per screenshot e scraping (pesante: abilita solo se serve).",
      "transport": "stdio",
      "install": "npx -y @modelcontextprotocol/server-puppeteer",
      "needs": [],
      "config": {
        "command": "npx",
        "args": ["-y", "@modelcontextprotocol/server-puppeteer"],
        "tools": { "exclude": ["delete_*"] }
      }
    },
    {
      "name": "composio",
      "description": "1000+ app via Composio (Gmail, Notion, Linear...): incolla l'URL MCP della tua sessione.",
      "transport": "http",
      "install": "dashboard Composio → crea sessione → copia l'URL MCP",
      "needs": ["URL sessione Composio", "COMPOSIO_API_KEY (se richiesto dall'endpoint)"],
      "config": {
        "url": "https://mcp.composio.dev/v3/mcp/TUA-SESSIONE",
        "headers": { "x-api-key": "***" },
        "tools": { "exclude": ["delete_*"] }
      }
    },
    {
      "name": "openai-compatibile",
      "description": "Qualunque gateway OpenAI-compatibile (LiteLLM, OpenRouter MCP, aziendale).",
      "transport": "http",
      "install": "nessuna: punta url al tuo gateway",
      "needs": ["token bearer"],
      "config": {
        "url": "https://TUO-GATEWAY/mcp",
        "headers": { "Authorization": "Bearer ***" }
      }
    },
    {
      "name": "ollama-locale",
      "description": "Ollama on-premise dietro bridge MCP. Zero cloud.",
      "transport": "http",
      "install": "esponi un bridge MCP su http://localhost:11434/mcp",
      "needs": [],
      "config": { "url": "http://localhost:11434/mcp" }
    }
  ]
}
